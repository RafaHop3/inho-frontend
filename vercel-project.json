{
  "name": "inho-frontend",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://inho-api.orbesystems.com.br",
    "NEXT_PUBLIC_INHO_URL": "https://inho.orbesystems.com.br"
  }
}
